# ---------- LLM ----------
OPENAI_API_KEY=
# Model used by the text agent (Phase 1). Correctness matters most here.
OPENAI_MODEL=gpt-4.1
# Optional: any OpenAI-compatible endpoint (Groq, Azure, ...).
# OPENAI_BASE_URL=

# ---------- Storage ----------
# "google" uses Google Calendar + Sheets. "memory" runs fully in-process with
# seeded demo data (no Google account needed) - handy for a first look.
# If unset: google when the two IDs below are present, otherwise memory.
# STORE=google
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=
# Service-account key: either a path to the JSON file...
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# ...or the JSON itself, base64-encoded (useful on hosts without a filesystem).
# GOOGLE_SERVICE_ACCOUNT_B64=

# ---------- Shop ----------
# Leave unset to follow the Google Calendar's own timezone (recommended), so a
# "4:30 PM" booking shows at 4:30 PM in the calendar. Demo mode defaults to
# America/Los_Angeles. Set it only to force a specific zone.
# SHOP_TIMEZONE=America/Los_Angeles
# Country calling code assumed when a caller gives a 10-digit number.
DEFAULT_COUNTRY_CODE=1
# Number of cars that can be worked on at once. 1 = any overlapping event makes a slot full.
SHOP_BAYS=1

# ---------- Server ----------
PORT=3000

# ---------- Phase 2: Vapi ----------
VAPI_API_KEY=
# Public HTTPS base URL of this server (ngrok / Render / Fly ...), no trailing slash.
PUBLIC_URL=
# Shared secret Vapi sends back in the X-Vapi-Secret header on every webhook.
VAPI_WEBHOOK_SECRET=change-me
# Set after the first `npm run vapi:sync` so later runs update the same assistant.
VAPI_ASSISTANT_ID=
# Model Vapi runs for the voice agent. Smaller = faster first token.
VAPI_MODEL=gpt-4.1-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Savannah
# VAPI_VOICE_MODEL=
# deepgram model: nova-3 (default) or flux-general-en (built-in end-of-turn detection)
VAPI_TRANSCRIBER_MODEL=nova-3
# Optional: a real person to transfer to (E.164). Leave empty to take messages instead.
HUMAN_TRANSFER_NUMBER=
